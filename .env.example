# Copy this file to .env and adjust what you need. Everything except
# N8N_ENCRYPTION_KEY has a working default for a local demo.

# --- required ---------------------------------------------------------------
# Any long random string. n8n encrypts stored credentials with it.
# Generate one with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- AI qualification (optional) --------------------------------------------
# Any OpenAI-compatible chat completions API. Leave LLM_API_KEY empty to use
# the built-in rule-based scorer instead, so the demo also runs offline.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Local Ollama example (key can be any text):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1

# --- your (fictional) company -------------------------------------------------
COMPANY_NAME=Northwind Analytics
COMPANY_DESCRIPTION=a reporting automation platform for operations teams
SENDER_NAME=Maya from Northwind
SENDER_EMAIL=maya@northwind.test
# Hot and warm leads are shared between these reps (comma separated)
SALES_REPS=alex@northwind.test,sam@northwind.test
BOOKING_URL=https://cal.com/northwind/intro

# --- behaviour ----------------------------------------------------------------
# true: one sequence "day" is one minute, so you can watch the follow-ups arrive.
# Set to false for real day-based timing.
DEMO_FAST_FOLLOW_UPS=true
# Base URL used in the links inside emails
PUBLIC_BASE_URL=http://localhost:5678
# If set, POST /webhook/lead must send the header X-Webhook-Secret with this value
LEAD_WEBHOOK_SECRET=
# If set, the CRM board needs ?token=<value>
CRM_BOARD_TOKEN=
TIMEZONE=Europe/London

# Password for the CRM database (letters and digits only)
CRM_DB_PASSWORD=crm_dev_password
