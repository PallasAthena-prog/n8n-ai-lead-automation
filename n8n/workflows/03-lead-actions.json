    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ecc29035-d79c-54a5-aebd-b054ecd5b3c6",
              "name": "config",
              "value": "={{ {\n  companyName: $env.COMPANY_NAME || 'Northwind Analytics',\n  companyDescription: $env.COMPANY_DESCRIPTION || 'a reporting automation platform for operations teams',\n  senderName: $env.SENDER_NAME || 'Maya from Northwind',\n  senderEmail: $env.SENDER_EMAIL || 'maya@northwind.test',\n  salesReps: ($env.SALES_REPS || 'alex@northwind.test,sam@northwind.test').split(',').map(r => r.trim()).filter(r => r),\n  bookingUrl: $env.BOOKING_URL || 'https://cal.com/northwind/intro',\n  publicUrl: ($env.PUBLIC_BASE_URL || 'http://localhost:5678').replace(/\\/+$/, ''),\n  llmEnabled: !!$env.LLM_API_KEY,\n  llmBaseUrl: ($env.LLM_BASE_URL || 'https://api.openai.com/v1').replace(/\\/+$/, ''),\n  llmModel: $env.LLM_MODEL || 'gpt-4o-mini',\n  followUpUnit: ($env.DEMO_FAST_FOLLOW_UPS || 'true') === 'true' ? '1 minute' : '1 day'\n} }}",
              "type": "object"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true
      },
      "id": "b586a39c-7c20-5109-aae8-78be2d04b23c",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Email links look like /webhook/lead-action?lead=12&token=<uuid>&action=book\n// The confirmation form posts the same fields plus confirm=yes in the body.\nconst input = $input.first().json;\nconst query = input.query || {};\nconst body = input.body && typeof input.body === 'object' ? input.body : {};\nconst pick = (key) => String(body[key] ?? query[key] ?? '');\n\nconst leadId = pick('lead');\nconst token = pick('token');\nconst action = pick('action');\n\nconst ok = /^\\d{1,18}$/.test(leadId)\n  && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(token)\n  && ['book', 'unsubscribe'].includes(action);\n\nreturn [{ json: { ok, confirmed: body.confirm === 'yes', leadId, token, action } }];\n"
      },
      "id": "104d02f3-ee1b-5061-98c6-265619a1eaaa",
      "name": "Check Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d75e258d-530a-57c4-a0cf-a478a2612e37",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "26eab71c-6f03-56a6-b676-800cd16d77e9",
      "name": "Link Looks Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "25a8f437-abe6-5ff6-a7e4-1f7e4f5c701f",
              "leftValue": "={{ $json.confirmed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ddb0a579-3162-58b2-a791-2dd0e902b9d5",
      "name": "Confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ `<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>${$json.action === 'book' ? 'Book a call' : 'Unsubscribe'}</title></head>\n<body style=\"font-family:Arial,Helvetica,sans-serif;background:#f5f7fa;color:#1f2933;margin:0;padding:48px 16px\">\n<div style=\"max-width:480px;margin:0 auto;background:#fff;border-radius:10px;padding:32px;box-shadow:0 1px 3px rgba(0,0,0,.08)\">\n<h1 style=\"font-size:22px;margin:0 0 12px\">${$json.action === 'book' ? 'Book a call with ' + $('Config').first().json.config.companyName : 'Unsubscribe from our emails?'}</h1>\n<p style=\"margin:0 0 24px;line-height:1.5\">${$json.action === 'book' ? 'Pick a time that suits you in our calendar. We will stop sending reminder emails.' : 'You will not get any more follow-up emails from ' + $('Config').first().json.config.companyName + '.'}</p>\n<form method=\"post\" action=\"${$('Config').first().json.config.publicUrl}/webhook/lead-action\">\n<input type=\"hidden\" name=\"lead\" value=\"${$json.leadId}\">\n<input type=\"hidden\" name=\"token\" value=\"${$json.token}\">\n<input type=\"hidden\" name=\"action\" value=\"${$json.action}\">\n<input type=\"hidden\" name=\"confirm\" value=\"yes\">\n<button type=\"submit\" style=\"padding:12px 20px;border:0;border-radius:6px;background:#2f6fed;color:#fff;font-size:15px;cursor:pointer\">${$json.action === 'book' ? 'Continue to the calendar' : 'Yes, unsubscribe me'}</button>\n</form>\n</div></body></html>` }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "25251e1d-9a98-5431-b902-fe8101ca4b76",
      "name": "Ask to Confirm",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1100,
        340
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with target as (\n  select id, status as old_status\n    from leads\n   where id = $1::bigint\n     and response_token = $2::uuid\n     and status <> 'disqualified'\n     for update\n), updated as (\n  update leads l\n     set status = case when $3::text = 'book' then 'meeting_requested' else 'unsubscribed' end,\n         next_follow_up_at = null,\n         updated_at = now()\n    from target t\n   where l.id = t.id\n  returning l.id, l.full_name, l.email, l.company, l.owner_email, l.category, l.score, l.summary,\n            l.status, t.old_status\n), logged as (\n  -- only log real changes, so a second click does not notify anyone again\n  insert into lead_activities (lead_id, type, detail)\n  select id, status, jsonb_build_object('previous_status', old_status)\n    from updated\n   where old_status is distinct from status\n)\nselect $3::text as action,\n       coalesce((select row_to_json(u) from updated u), '{}'::json) as lead,\n       coalesce((select u.old_status is distinct from u.status from updated u), false) as changed",
        "options": {
          "queryReplacement": "={{ [$json.leadId, $json.token, $json.action] }}"
        }
      },
      "id": "3fc54307-2431-5942-8336-d303b6c51bf0",
      "name": "Apply Action in CRM",
