        "responseBody": "={{ `<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Unsubscribed</title></head>\n<body style=\"font-family:Arial,Helvetica,sans-serif;background:#f5f7fa;color:#1f2933;margin:0;padding:48px 16px\">\n<div style=\"max-width:480px;margin:0 auto;background:#fff;border-radius:10px;padding:32px;box-shadow:0 1px 3px rgba(0,0,0,.08)\">\n<h1 style=\"font-size:22px;margin:0 0 12px\">You're unsubscribed</h1>\n<p style=\"margin:0;line-height:1.5\">You won't get any more follow-up emails from ${$('Config').first().json.config.companyName}. If that was a mistake, just reply to one of our emails.</p>\n</div></body></html>` }}",
