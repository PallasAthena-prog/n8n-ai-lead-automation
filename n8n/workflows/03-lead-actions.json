        "toEmail": "={{ $json.lead.owner_email || $('Config').first().json.config.salesReps[0] || $('Config').first().json.config.senderEmail }}",
        "subject": "=Meeting requested: {{ $json.lead.full_name }}{{ $json.lead.company ? ', ' + $json.lead.company : '' }}",
        "emailFormat": "text",
        "text": "={{ [\n  $json.lead.full_name + ' confirmed they want a call and is on their way to your calendar.',\n  '',\n  'Category: ' + $json.lead.category + ' (score ' + $json.lead.score + ')',\n  'Summary: ' + ($json.lead.summary || 'n/a'),\n  'Email: ' + $json.lead.email,\n  '',\n  'Automatic follow-ups for this lead have stopped.'\n].join('\\n') }}",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $json.lead.email }}"
        }
      },
